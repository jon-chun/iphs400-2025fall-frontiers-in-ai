        "from transformers import AutoModelWithLMHead, AutoTokenizer\n",
        "\n",
        "model = \"mrm8488/t5-base-finetuned-span-sentiment-extraction\"\n",
        "tokenizer = AutoTokenizer.from_pretrained(model)\n",
