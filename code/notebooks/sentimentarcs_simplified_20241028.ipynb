        "\"\"\"\n",
        "# Example usage:\n",
        "\n",
        "model_name = \"mistralai/Mistral-7B-Instruct-v0.1\"\n",
        "lines = [\n",
        "    \"I absolutely love this beautiful day!\",\n",
        "    \"This is the worst experience ever.\",\n",
        "    \"The weather is quite nice today.\"\n",
        "]\n",
        "sentiment_scores = get_llm_sentiment(model_name, lines)\n",
